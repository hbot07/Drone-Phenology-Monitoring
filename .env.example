# =============================================================================
# Drone Phenology Monitoring — environment template.
# Copy to `.env`, fill in real values, and NEVER commit `.env` (.gitignore it).
# docker-compose.yml auto-loads `.env`. No secrets belong in the Dockerfile
# or in source — everything here is read at runtime.
# =============================================================================

# --- Image ---
# Local dev: build the image yourself and keep PULL_POLICY=never.
# Cluster / clean host: switch to the registry tag and PULL_POLICY=always:
#   DPM_IMAGE=surryyansh/dpm-pipeline:1.0.0
#   DPM_PULL_POLICY=always
DPM_IMAGE=dpm-pipeline:latest
DPM_PULL_POLICY=never

# --- Database ---
# DEV DEFAULT: talks to the local dpm-postgres sidecar in docker-compose.yml.
# CLUSTER DEPLOY: point these at the central Postgres instance instead and
# remove the dpm-postgres service from docker-compose.yml. Ask the server
# DBA for the database name / role.
DPM_DB_NAME=dpm
DPM_DB_USER=dpm
DPM_DB_PASSWORD=change-me
DPM_DB_HOST=dpm-postgres
DPM_DB_PORT=5432

# --- Auth (Google SSO only) ---
# Create OAuth 2.0 credentials at console.cloud.google.com → APIs & Services → Credentials.
# Under "Authorized JavaScript origins" add the exact URL users access the app from,
# e.g. http://yourserver:8090 — Google will silently reject sign-in if this is wrong.
DPM_AUTH_ENABLED=true
DPM_GOOGLE_CLIENT_ID=
# Signs the app's own session/JWT tokens — generate a fresh random value:
#   openssl rand -hex 32
# This is NOT your Google client secret. Rotating this value invalidates all
# existing sessions (users will need to sign in again).
DPM_SECRET_KEY=
DPM_SESSION_HOURS=24

# --- Compute mode ---
# AIRFLOW_API_BASE is THE switch — do not add a separate COMPUTE_MODE flag.
#   empty  -> pipeline runs locally, inside this container
#   set    -> dashboard triggers/polls this DAG via the Airflow REST API
AIRFLOW_API_BASE=
AIRFLOW_DAG_ID=drone_phenology_monitoring
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
# Alternative to USERNAME/PASSWORD — bearer auth (set one, not both):
AIRFLOW_TOKEN=
# Where the AIRFLOW WORKER reaches this backend's callback endpoint.
# Must be a LAN/Docker-network address reachable from the worker,
# not `localhost`. Only needed when AIRFLOW_API_BASE is set.
CORESTACK_API_BASE=

# --- Frontend API base URL ---
# The JS frontend reads this from /api/config at boot and uses it as the
# prefix for all subsequent API calls.  Never hardcode API paths in JS.
#
#   Same-container deploy (default):
#     DPM_API_BASE_URL=/api
#     → relative path; works as long as the browser and the FastAPI server
#       share the same origin (the common single-container case).
#
#   CDN / reverse-proxy / cross-origin deploy:
#     DPM_API_BASE_URL=https://dpm.example.com/api
#     → absolute URL; use when the frontend is served from a different origin
#       than the FastAPI backend (e.g. a CDN-hosted SPA hitting an API server).
#       Add the frontend origin to CORS_ORIGINS in server.py as well.
DPM_API_BASE_URL=/api

# --- Proxy (IIT Delhi cluster hosts) ---
# Remove or leave empty if not behind the IITD proxy.
HTTP_PROXY=http://proxy21.iitd.ac.in:3128
HTTPS_PROXY=http://proxy21.iitd.ac.in:3128
# NO_PROXY must only list internal Docker-network hostnames.
# Do NOT put Google domains here. On the IITD network there is no direct
# internet — all outbound traffic must go through the proxy above. If Google
# domains are in NO_PROXY, Python's requests library bypasses the proxy for
# them, the direct connection is blocked by the firewall, and Google token
# verification hangs until nginx returns a 504 on every sign-in attempt.
NO_PROXY=dpm-titiler,dpm-postgres,localhost,127.0.0.1
no_proxy=dpm-titiler,dpm-postgres,localhost,127.0.0.1

# --- Pipeline paths (must match the mounts in docker-compose.yml) ---
DPM_PROJECT_ROOT=/app
DPM_MODEL_PATH=/app/models/250312_flexi.pth
DPM_RUNS_DIR=/app/data/runs
# Max upload size per orthomosaic (bytes). Default: 2 GB. Set 0 to disable.
DPM_MAX_OM_BYTES=2147483648

# --- Detector model catalog (crown-detection .pth weights, GET /api/models) ---
# Detectors available in the "Model" dropdown on the New Run page are listed
# in models.yaml, which lives next to server.py (src/flask_app_tracking/) and
# is read automatically — no env var needed for the default setup.
# To add a model: drop the new .pth file into ./models/ and add an entry to
# models.yaml, then restart the dashboard container (the manifest is cached
# per-process, so edits need a restart, not a rebuild).
# Only set this if you want the manifest to live somewhere other than next
# to server.py (e.g. to point at a different file for testing):
# DPM_MODELS_MANIFEST=/app/models.yaml

# --- Phenophase classifier model ---
# Path to the pre-trained GradientBoosting .joblib model inside the container.
# Place phenophase_gb.joblib in your ./models/ folder on the host — it is
# mounted at /app/models/ by docker-compose.yml (cluster) or available at
# /app/models/ via the single-mount in local dev.
#
# run_pipeline.sh reads this env var directly and passes the path to step 3b
# (12_apply_phenophase_to_geojson.py). If the file is absent, step 3b is
# SKIPPED with a warning and the run completes without phenophase labels.
# Set DPM_REQUIRE_PHENOCLF=1 to make a missing model a hard error instead.
DPM_PHENOCLF_MODEL=/app/models/phenophase_gb.joblib
# DPM_REQUIRE_PHENOCLF=1   # uncomment to fail the run if the model is missing

# --- FileBrowser (optional — blank base URL disables) ---
# External file browser UI for run outputs. Start with:
#   docker compose --profile filebrowser up -d
# Then set the URLs below so the dashboard creates share links.
#
# BASE_URL: how the dashboard container reaches FileBrowser (Docker network).
#   To enable: DPM_FILEBROWSER_BASE_URL=http://dpm-filebrowser:80
# PUBLIC_URL: how the user's browser reaches FileBrowser (host/external).
# USERNAME/PASSWORD: FileBrowser admin credentials (default: admin / empty).
# RUNS_PATH: prefix inside /srv if runs aren't at the root (usually leave empty).
DPM_FILEBROWSER_BASE_URL=
DPM_FILEBROWSER_PUBLIC_URL=http://localhost:8098
DPM_FILEBROWSER_USERNAME=admin
DPM_FILEBROWSER_PASSWORD=
DPM_FILEBROWSER_RUNS_PATH=
DPM_FILEBROWSER_PORT=8098

# --- Logging ---
# debug | info | error — written under data/logs/drone-phenology-monitoring/
LOG_LEVEL=info
LOG_TIMEZONE=Asia/Kolkata