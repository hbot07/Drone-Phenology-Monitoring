# =============================================================================
# All runtime config and secrets — copy to .env and fill in values.
# This file IS committed to git; .env is NOT.
# =============================================================================

# --- Database ---
DPM_DB_NAME=dpm
DPM_DB_USER=dpm
DPM_DB_PASSWORD=<choose-a-strong-password>

# --- Auth ---
DPM_AUTH_ENABLED=true
DPM_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
DPM_SECRET_KEY=<your-google-client-secret>
DPM_SESSION_HOURS=24

# --- Proxy (set blank if not behind a proxy) ---
HTTP_PROXY=http://proxy21.iitd.ac.in:3128
HTTPS_PROXY=http://proxy21.iitd.ac.in:3128

# --- Pipeline paths (must match the /workspace mount in docker-compose.yml) ---
DPM_PROJECT_ROOT=/workspace
DPM_MODEL_PATH=/workspace/input/detectree_models/250312_flexi.pth

# --- Logging ---
LOG_LEVEL=info
